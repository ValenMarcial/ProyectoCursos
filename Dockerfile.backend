FROM maven:3.9-eclipse-temurin-11 AS build
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
COPY web ./web
RUN mvn -B -Pbackend -DskipTests clean package

FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=build /workspace/target/backend/ProyectoCursos-0.0.1-SNAPSHOT-backend.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
